<?xml version="1.0" encoding="utf-8"?>
<!-- Swift Folio mark: a document (folio) dropping into a bucket, in the brand gradient.
     Everything sits inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Bucket rim and opening -->
    <path
        android:fillColor="#FF9B6BFF"
        android:pathData="M33,45 A21,6 0 1,0 75,45 A21,6 0 1,0 33,45 Z" />
    <path
        android:fillColor="#FF07090E"
        android:pathData="M36.5,45 A17.5,3.8 0 1,0 71.5,45 A17.5,3.8 0 1,0 36.5,45 Z" />
    <!-- Folio page with a folded corner -->
    <path
        android:fillColor="#FFE8ECF4"
        android:pathData="M46,27 L58,27 L63,32 L63,48 L46,48 Z" />
    <path
        android:fillColor="#FFA4AEC2"
        android:pathData="M58,27 L58,32 L63,32 Z" />
    <!-- Bucket body -->
    <path android:pathData="M33,45 C36,50 72,50 75,45 L70.2,76.4 C69.8,79.2 67.5,81 64.8,81 L43.2,81 C40.5,81 38.2,79.2 37.8,76.4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="75"
                android:endY="81"
                android:startX="33"
                android:startY="45"
                android:type="linear">
                <item
                    android:color="#FF2E5BFF"
                    android:offset="0" />
                <item
                    android:color="#FF6E44FF"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- Hairline bands -->
    <path
        android:fillColor="#40FFFFFF"
        android:pathData="M38.6,59 L69.4,59 L69,61.5 L39,61.5 Z" />
    <path
        android:fillColor="#40FFFFFF"
        android:pathData="M39.9,68 L68.1,68 L67.7,70.5 L40.3,70.5 Z" />
</vector>
